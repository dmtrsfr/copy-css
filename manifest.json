{
  "manifest_version": 3,
  "name": "Grab Styles",
  "version": "0.1.0",
  "description": "Toggle an inspect-element picker to select elements on the page.",
  "action": {
    "default_title": "Grab Styles: toggle element picker"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
