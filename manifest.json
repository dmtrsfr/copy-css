{
  "manifest_version": 3,
  "name": "Copy CSS",
  "version": "0.1.0",
  "description": "Click any element to copy its HTML and computed CSS as a ready-to-use snippet. Great for cloning UI styles fast.",
  "action": {
    "default_title": "Copy CSS"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
